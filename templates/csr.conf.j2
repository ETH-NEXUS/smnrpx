[ req ]
default_bits = 2048
default_md = sha256
{% if domain.sans %}
req_extensions = req_ext
x509_extensions = v3_req
{% endif %}
distinguished_name = dn
prompt = no

[ dn ]
C = XX
ST = N/A
L = N/A
O = Self-signed certificate
CN = {{ domain_name }}

{% if domain.sans %}
[ req_ext ]
subjectAltName = @alt_names

[ v3_req ]
subjectAltName = @alt_names

[ alt_names ]
{# 'set' does not survive a loop iteration, so the index comes from the loop itself. #}
{# The common name has to be repeated here, clients ignore it once SANs are present. #}
DNS.1 = {{ domain_name }}
{% for san in domain.sans %}
DNS.{{ loop.index + 1 }} = {{ san }}
{% endfor %}
{% endif %}